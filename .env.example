# HireLens Environment Configuration
# Copy this file to .env and fill in your values.

# Flask secret key for session management (REQUIRED - change in production)
SECRET_KEY=dev-secret-key-change-in-production

# Database URL (defaults to SQLite for local development)
# For PostgreSQL: postgresql://user:password@host:5432/hirelens
DATABASE_URL=sqlite:///resumeai.db

# Google Gemini API key (OPTIONAL)
# If left blank or unset, HireLens will automatically operate in Demo/Fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum file upload size in megabytes (default: 5MB)
MAX_CONTENT_LENGTH_MB=5

# IMPORTANT: Never commit your actual .env file to Git.
# NEVER expose: SECRET_KEY, DATABASE_URL (with credentials), or GEMINI_API_KEY in source code.
